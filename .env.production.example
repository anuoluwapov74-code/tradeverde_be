# ── Security ──────────────────────────────────────────────────
SECRET_KEY=replace-with-a-long-random-string-min-50-chars
DEBUG=False

# ── Database (Neon serverless PostgreSQL) ─────────────────────
# Get this from your Neon dashboard → project → Connection string
# Make sure to select "Pooled connection" for production
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-xxxx.us-east-2.aws.neon.tech/dbname?sslmode=require

# ── Hosts ─────────────────────────────────────────────────────
ALLOWED_HOSTS=verdifytrades.com,www.verdifytrades.com,api.verdifytrades.com
CORS_ALLOWED_ORIGINS=https://verdifytrades.com,https://www.verdifytrades.com
FRONTEND_URL=https://verdifytrades.com

# ── Email (Resend) ────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxx
DEFAULT_FROM_EMAIL=VerdifyTrades <support@verdifytrades.com>
ADMIN_NOTIFICATION_EMAIL=support@verdifytrades.com

# ── Email (SMTP fallback) ─────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_HOST_USER=your-gmail@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# ── Cloudinary ────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
